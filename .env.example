# ── Required ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kencole?schema=public"
SESSION_SECRET="generate with: openssl rand -base64 48"
APP_URL="http://localhost:3000"

# ── Storage ────────────────────────────────────────────────────────────────
STORAGE_PROVIDER="local"          # local | database | s3  (database: files in Postgres, for serverless hosts)
STORAGE_LOCAL_DIR="./.storage"
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Payments ───────────────────────────────────────────────────────────────
PAYMENT_PROVIDER="manual"         # manual | stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Email ──────────────────────────────────────────────────────────────────
EMAIL_PROVIDER="console"          # console | resend
# RESEND_API_KEY=
EMAIL_FROM="Kencole Customs Brokerage <no-reply@kencole.bs>"

# ── Invoice extraction ─────────────────────────────────────────────────────
DOCUMENT_AI_PROVIDER="mock"       # mock | external
# DOCUMENT_AI_URL=
# DOCUMENT_AI_KEY=

# ── Customs ────────────────────────────────────────────────────────────────
# Only "manual" exists. There is no sanctioned Click2Clear API in this codebase.
CUSTOMS_ADAPTER="manual"
